{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dependencies (Docker)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose --env-file web/.env -f ./dependencies/compose.yml up -d",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "backend",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "cwd": "${workspaceFolder}/web/backend"
    },
    {
      "name": "backend: tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "uv run pytest",
      "cwd": "${workspaceFolder}/web/backend"
    },
    {
      "name": "frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --strictPort",
      "cwd": "${workspaceFolder}/web/frontend"
    },
    {
      "name": "web: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/web/frontend"
    }
  ],
  "compounds": [
    {
      "name": "backend + frontend",
      "configurations": [
        "backend",
        "frontend"
      ],
      "stopAll": true
    }
  ]
}