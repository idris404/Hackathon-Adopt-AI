{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hla-twin.local/schemas/restitution.schema.json",
  "title": "HLA Twin expected restitution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "synthetic",
    "phase",
    "profile",
    "assays",
    "current_result_summary",
    "history_pattern",
    "history_pattern_status",
    "trend",
    "discordances",
    "review_status",
    "candidate_for_simplified_review",
    "triggered_rules",
    "ruleset_version",
    "uncertainties",
    "human_validation_required",
    "provenance"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^SYN-CASE-[0-9]{3}$"},
    "synthetic": {"const": true},
    "phase": {"enum": ["pre_transplant", "post_transplant"]},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_score",
        "validated_partial_score",
        "score_status",
        "proposed_risk_category",
        "category_status",
        "context",
        "factors",
        "missing_data"
      ],
      "properties": {
        "profile_score": {"type": ["integer", "null"], "minimum": 0},
        "validated_partial_score": {"type": "integer", "minimum": 0},
        "score_status": {"enum": ["pending_review", "partially_calculated", "calculated", "validated"]},
        "proposed_risk_category": {
          "enum": ["minimal", "moderate", "medium", "high", "very_high", "uncertain"]
        },
        "category_status": {"enum": ["pending_review", "validated"]},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sex_at_birth", "dialysis", "rejection_suspicion", "organ_context"],
          "properties": {
            "sex_at_birth": {"type": "object"},
            "dialysis": {"type": "object"},
            "rejection_suspicion": {"type": "object"},
            "organ_context": {"type": "object"}
          }
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor_id", "availability", "source_value", "contribution", "rule_status", "justification"],
            "properties": {
              "factor_id": {"type": "string", "pattern": "^PF-[0-9]{2}$"},
              "availability": {"enum": ["known", "missing", "not_applicable", "contradictory"]},
              "source_value": {},
              "contribution": {"type": ["integer", "null"]},
              "rule_status": {"enum": ["proposed", "blocked", "pending_review", "validated"]},
              "justification": {"type": "string", "minLength": 1}
            }
          }
        },
        "missing_data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason", "impact"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "impact": {"enum": ["prevents_favorable_output", "requires_human_review", "informational"]}
            }
          }
        }
      }
    },
    "assays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assay_id", "serum_id", "source_result", "result_availability"],
        "properties": {
          "assay_id": {"type": "string"},
          "serum_id": {"type": "string"},
          "source_result": {"enum": ["negative", "positive", "doubtful", null]},
          "result_availability": {"enum": ["present", "missing"]}
        }
      }
    },
    "current_result_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serum_id", "current_source_results", "current_result", "status"],
      "properties": {
        "serum_id": {"type": ["string", "null"]},
        "current_source_results": {
          "type": "array",
          "items": {"enum": ["negative", "positive", "doubtful"]},
          "uniqueItems": true
        },
        "current_result": {"enum": ["negative", "positive", "doubtful", null]},
        "status": {"enum": ["source_consistent", "discordance_unresolved", "data_missing"]}
      }
    },
    "history_pattern": {
      "enum": ["negative_constant", "positive_constant", "doubtful_constant", "evolving", "fluctuating", "indeterminate"]
    },
    "history_pattern_status": {"enum": ["pending_review", "validated"]},
    "trend": {"enum": ["increasing", "decreasing", "stable", "indeterminate"]},
    "discordances": {"type": "array", "items": {"type": "object"}},
    "review_status": {"enum": ["human_review_required", "candidate_for_simplified_review", "blocked"]},
    "candidate_for_simplified_review": {"type": "boolean"},
    "triggered_rules": {"type": "array", "items": {"type": "string"}},
    "ruleset_version": {"const": "DEMO-PARTIAL-0.2.0"},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "human_validation_required": {"const": true},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_copied", "generator_version"],
      "properties": {
        "source_record_copied": {"const": false},
        "generator_version": {"enum": ["manual-fixture-v1", "deterministic-generator-v1", "balanced-generator-v1"]},
        "simulation_scenario": {"type": "string", "minLength": 1}
      }
    }
  }
}
