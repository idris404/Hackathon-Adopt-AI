# PostgreSQL (lu par dependencies/compose.yml)
# Valeurs pour le développement local uniquement : ne jamais réutiliser ce mot de passe ailleurs.
# Docker Compose ne lit pas ce fichier tout seul : lancer avec `--env-file web/.env`.
# DB_USER, DB_PASSWORD et DB_NAME ne sont pris en compte qu'à la première initialisation des données.
DB_USER=adopt_ai
DB_PASSWORD=password
DB_NAME=adopt_ai_db
DB_PORT=5432
