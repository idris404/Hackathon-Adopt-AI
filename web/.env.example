# PostgreSQL (lu par dependencies/compose.yml)
# Valeurs pour le développement local uniquement : ne jamais réutiliser ce mot de passe ailleurs.
# Docker Compose ne lit pas ce fichier tout seul : lancer avec `--env-file web/.env`.
# DB_USER, DB_PASSWORD et DB_NAME ne sont pris en compte qu'à la première initialisation des données.
DB_USER=adopt_ai
DB_PASSWORD=password
DB_NAME=adopt_ai_db
DB_PORT=5432

# Backend (FastAPI) — lues par backend/app/core/config.py
# DB_USER, DB_PASSWORD, DB_NAME et DB_PORT (ci-dessus) servent aussi à la connexion du backend.
DB_HOST=localhost
# Origine du frontend autorisée par CORS (le cookie de session circule entre les deux).
FRONTEND_URL=http://localhost:5173
# Cookie de session `Secure` : true par défaut (HTTPS). false uniquement en développement local en HTTP.
COOKIE_SECURE=false

# Seed : compte de démonstration créé par `uv run python -m app.seed` (étape `users`, depuis backend/).
# Lues par le seul seed (SeedSettings, core/config.py), jamais par l'API. Le mot de passe respecte les
# règles d'inscription (12 à 256 caractères). Développement local uniquement : ne jamais réutiliser
# ces valeurs ailleurs, ni les garder sur un environnement réel.
SEED_USER_EMAIL=admin@email.fr
SEED_USER_PASSWORD=password@2026
